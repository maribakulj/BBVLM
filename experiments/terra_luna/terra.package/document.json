    },
    {
      "id": "R06_L03",
      "kind": "line",
      "parent": "R06",
      "page": "P1",
      "bbox": [
        214,
        352,
        795,
        389
      ],
      "text": "Die Wiener Liberalen haben noch immer kein",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R07_L01",
      "kind": "line",
      "parent": "R07",
      "page": "P1",
      "bbox": [
        213,
        1326,
        727,
        1372
      ],
      "text": "Die Regierung und die Beamten.",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R08_L01",
      "kind": "line",
      "parent": "R08",
      "page": "P1",
      "bbox": [
        606,
        1375,
        776,
        1397
      ],
      "text": "Wien 5. Juli.",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R08_L02",
      "kind": "line",
      "parent": "R08",
      "page": "P1",
      "bbox": [
        210,
        1398,
        795,
        1434
      ],
      "text": "Graf Kielmansegg hat gestern erklärt, die Regierung",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R08_L03",
      "kind": "line",
      "parent": "R08",
      "page": "P1",
      "bbox": [
        146,
        1430,
        796,
        1458
      ],
      "text": "sei „geradezu eifersüchtig“ darauf bedacht, die Sache der",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R09_L01",
      "kind": "line",
      "parent": "R09",
      "page": "P1",
      "bbox": [
        818,
        296,
        1464,
        323
      ],
      "text": "und nie wird das Parlament wirkliche Energie anwenden,",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R09_L02",
      "kind": "line",
      "parent": "R09",
      "page": "P1",
      "bbox": [
        818,
        326,
        1464,
        352
      ],
      "text": "um den Beamten ernstlich zu helfen, denn die Parteien",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R09_L03",
      "kind": "line",
      "parent": "R09",
      "page": "P1",
      "bbox": [
        817,
        349,
        1464,
        380
      ],
      "text": "wünschen zwar eine billige Popularität, aber noch mehr",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R10_L01",
      "kind": "line",
      "parent": "R10",
      "page": "P1",
      "bbox": [
        934,
        3078,
        1325,
        3128
      ],
      "text": "Österreichischer Reichsrath.",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R11_L01",
      "kind": "line",
      "parent": "R11",
      "page": "P1",
      "bbox": [
        1262,
        3135,
        1431,
        3165
      ],
      "text": "Wien, 5. Juli.",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R11_L02",
      "kind": "line",
      "parent": "R11",
      "page": "P1",
      "bbox": [
        873,
        3159,
        1446,
        3196
      ],
      "text": "Wenn Graf Kielmansegg sich gestern darauf berief, daß",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R11_L03",
      "kind": "line",
      "parent": "R11",
      "page": "P1",
      "bbox": [
        816,
        3182,
        1447,
        3220
      ],
      "text": "er die Zustände in Prag nicht kenne und daher nicht selbst",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R12_L01",
      "kind": "line",
      "parent": "R12",
      "page": "P1",
      "bbox": [
        1486,
        291,
        2136,
        324
      ],
      "text": "dar, und er brachte Thatsachen vor, die den edlen Grafen",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R12_L02",
      "kind": "line",
      "parent": "R12",
      "page": "P1",
      "bbox": [
        1486,
        317,
        2132,
        348
      ],
      "text": "Thun in helles Licht rücken. Dr. Kramarsch machte mit",
      "status": "ambiguous",
      "needs_alignment": true,
      "issues": [
        "model_uncertainty"
      ]
    },
    {
      "id": "R12_L03",
      "kind": "line",
      "parent": "R12",
      "page": "P1",
      "bbox": [
        1486,
        344,
        2132,
        372
      ],
      "text": "Recht darauf aufmerksam, wie ruhig das große",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R13_L01",
      "kind": "line",
      "parent": "R13",
      "page": "P1",
      "bbox": [
        1548,
        1397,
        1815,
        1422
      ],
      "text": "Nachstehend der Bericht:",
      "status": "automatic",
      "needs_alignment": true
    },
    {
      "id": "R13_L02",
      "kind": "line",
      "parent": "R13",
      "page": "P1",
      "bbox": [
        1551,
        1420,
        2136,
        1448
      ],
      "text": "Abgeordnetenhaus. (406. Sitzung.) Präsident Frei-",
      "status": "automatic",
      "needs_alignment": true
    },
    {
