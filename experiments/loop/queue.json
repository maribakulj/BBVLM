        "experiments/loop/next-a63/blind/request.json",
        "experiments/loop/next-a63/private-map.json",
        "experiments/loop/next-a63/blind/R729.png",
        "experiments/loop/next-a63/blind/R729-zoom.png",
        "experiments/loop/next-a63/blind/R184.png",
        "experiments/loop/next-a63/blind/R184-zoom.png",
        "experiments/loop/next-a63/blind/R563.png",
        "experiments/loop/next-a63/blind/R563-zoom.png",
        "experiments/loop/next-a63/blind/R902.png",
        "experiments/loop/next-a63/blind/R902-zoom.png",
        "experiments/loop/next-a63/blind/R347.png",
        "experiments/loop/next-a63/blind/R347-zoom.png",
        "experiments/loop/next-a63/blind/R816.png",
        "experiments/loop/next-a63/blind/R816-zoom.png"
