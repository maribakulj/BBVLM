{
  "schema": "bbvlm.queue/1",
  "resources": {
    "cpu": 1,
    "io": 2,
    "vlm": 1,
    "orchestrator": 1
  },
  "jobs": [
    {
      "id": "a62_dispatch_tests",
      "kind": "command",
      "resource": "cpu",
      "deps": [],
      "inputs": [
        "scripts/experiment_queue.py",
        "tests/test_experiment_queue.py"
      ],
      "outputs": [
        "experiments/loop/queue-a62/dispatched-tests.json"
      ],
      "argv": [
        "{python}",
        "tests/test_experiment_queue.py",
        "--report",
        "experiments/loop/queue-a62/dispatched-tests.json"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "a62_visual_input_fixity",
      "kind": "command",
      "resource": "io",
      "deps": [],
      "inputs": [
        "scripts/audit_queue_inputs_a62.py",
        "experiments/loop/bnl-bands-a60/blind/request.json",
        "experiments/loop/bnl-guard-a61/blind/V1.png",
        "experiments/loop/bnl-guard-a61/blind/V2.png",
        "experiments/loop/bnl-guard-a61/blind/V3.png"
      ],
      "outputs": [
        "experiments/loop/queue-a62/source-integrity.json"
      ],
      "argv": [
        "{python}",
        "scripts/audit_queue_inputs_a62.py"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "a63_prepare",
      "kind": "external",
      "resource": "orchestrator",
      "deps": [
        "a62_dispatch_tests",
        "a62_visual_input_fixity"
      ],
      "inputs": [
        "experiments/loop/bnl-guard-a61/report.json",
        "experiments/loop/REFERENCE_AUDIT.md"
      ],
      "outputs": [
        "experiments/loop/next-a63/PROTOCOL.md"
      ],
      "instructions": "Active Codex: reread Claude branch head and new JOURNAL/protocol/code (O13/S05 if present); inspect A61 residuals against native images in a separately labelled diagnostic without rewriting references. Read primary literature for any new hypothesis and append one summary per paper, distinguishing abstract/full text. Freeze a concrete A63 protocol and add its preparation, blind-reader, scoring, review and commit-evidence jobs. Do not claim that another model is independent human adjudication. Keep the 100 reserved Chronicling test pages unopened until a transfer protocol is frozen; if adjudication is unavailable, advance predicted geometry/OLR/retrieval on a distinct ready track. Never wait for the next scheduled wake-up when useful work is available."
    },
    {
      "id": "a63_crops",
      "kind": "command",
      "resource": "cpu",
      "deps": [
        "a63_prepare"
      ],
      "inputs": [
        "scripts/prepare_residual_a63.py",
        "experiments/loop/next-a63/PROTOCOL.md",
        "experiments/loop/bnl-independent-a54/source/0455.png",
        "experiments/loop/bnl-independent-a54/source/0455.xml"
      ],
      "outputs": [
        "experiments/loop/next-a63/blind/request.json",
        "experiments/loop/next-a63/private-map.json",
        "experiments/loop/next-a63/blind/R729.png",
        "experiments/loop/next-a63/blind/R729-zoom.png",
        "experiments/loop/next-a63/blind/R184.png",
        "experiments/loop/next-a63/blind/R184-zoom.png",
        "experiments/loop/next-a63/blind/R563.png",
        "experiments/loop/next-a63/blind/R563-zoom.png",
        "experiments/loop/next-a63/blind/R902.png",
        "experiments/loop/next-a63/blind/R902-zoom.png",
        "experiments/loop/next-a63/blind/R347.png",
        "experiments/loop/next-a63/blind/R347-zoom.png",
        "experiments/loop/next-a63/blind/R816.png",
        "experiments/loop/next-a63/blind/R816-zoom.png"
      ],
      "argv": [
        "{python}",
        "scripts/prepare_residual_a63.py"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "a63_reader",
      "kind": "external",
      "resource": "vlm",
      "deps": [
        "a63_crops"
      ],
      "inputs": [
        "experiments/loop/next-a63/blind/request.json",
        "experiments/loop/next-a63/blind/R729.png",
        "experiments/loop/next-a63/blind/R729-zoom.png",
        "experiments/loop/next-a63/blind/R184.png",
        "experiments/loop/next-a63/blind/R184-zoom.png",
        "experiments/loop/next-a63/blind/R563.png",
        "experiments/loop/next-a63/blind/R563-zoom.png",
        "experiments/loop/next-a63/blind/R902.png",
        "experiments/loop/next-a63/blind/R902-zoom.png",
        "experiments/loop/next-a63/blind/R347.png",
        "experiments/loop/next-a63/blind/R347-zoom.png",
        "experiments/loop/next-a63/blind/R816.png",
        "experiments/loop/next-a63/blind/R816-zoom.png"
      ],
      "outputs": [
        "experiments/loop/next-a63/sol-response.json"
      ],
      "instructions": "One fresh blind Sol reader. Only request.json and its twelve image views; original detail; no reference/candidate/scores. Exact opaque IDs. Real inference mandatory. Consumed audit, no new independent CER claim."
    },
    {
      "id": "a63_score",
      "kind": "command",
      "resource": "cpu",
      "deps": [
        "a63_reader"
      ],
      "inputs": [
        "scripts/evaluate_residual_a63.py",
        "scripts/evaluate_bnl_vlm_a54.py",
        "src/bbvlm/text_views.py",
        "src/bbvlm/metrics.py",
        "experiments/loop/next-a63/private-map.json",
        "experiments/loop/next-a63/sol-response.json",
        "experiments/loop/bnl-guard-a61/sol-response.json",
        "experiments/loop/bnl-independent-a54/source/0455.xml",
        "experiments/loop/bnl-independent-a54/source/0455.png"
      ],
      "outputs": [
        "experiments/loop/next-a63/report.json"
      ],
      "argv": [
        "{python}",
        "scripts/evaluate_residual_a63.py"
      ],
      "timeout_seconds": 60
    },
    {
      "id": "a64_prepare",
      "kind": "external",
      "resource": "orchestrator",
      "deps": [
        "a63_score"
      ],
      "inputs": [
        "experiments/loop/next-a63/report.json",
        "experiments/loop/next-a63/RESULTS.md"
      ],
      "outputs": [
        "experiments/loop/next-a64/PROTOCOL.md"
      ],
      "instructions": "Before new hypothesis: inspect current Claude branch head, protocols/results/code. Stop retuning consumed0455. Prepare an independent diverse validation for an image-observable risk router OR advance distinct geometry/OLR track while human adjudication is unavailable. Consider official HIPE scorer normalization (spaces retained, MER denominator) with existing source audits; do not replace current metrics. Read primary sources and append article summaries. Add concrete command/reader/scoring jobs; execute useful ready work immediately, commit/push and checkpoint after each completed experiment. All scientific gates remain false."
    },
    {
      "id": "a64_verify",
      "kind": "command",
      "resource": "cpu",
      "deps": [
        "a64_prepare"
      ],
      "inputs": [
        "scripts/verify_hipe_alignment_a64.py",
        "src/bbvlm/hipe_metrics.py",
        "scripts/evaluate_bnl_vlm_a54.py",
        "experiments/loop/bnl-independent-a54/vlm-input/request.json",
        "experiments/loop/bnl-independent-a54/vlm-input/private-map.json",
        "experiments/loop/bnl-independent-a54/luna-response.json"
      ],
      "outputs": [
        "experiments/loop/hipe-projection-a64/implementation-verification.json"
      ],
      "argv": [
        "{python}",
        "scripts/verify_hipe_alignment_a64.py"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "a64_score",
      "kind": "command",
      "resource": "cpu",
      "deps": [
        "a64_verify"
      ],
      "inputs": [
        "scripts/evaluate_hipe_projection_a64.py",
        "src/bbvlm/hipe_metrics.py",
        "scripts/evaluate_bnl_vlm_a54.py",
        "experiments/loop/hipe-projection-a64/implementation-verification.json",
        "experiments/loop/bnl-independent-a54/vlm-input/request.json",
        "experiments/loop/bnl-independent-a54/vlm-input/private-map.json",
        "experiments/loop/bnl-independent-a54/luna-response.json",
        "experiments/loop/bnl-independent-a54/vlm-report.json"
      ],
      "outputs": [
        "experiments/loop/hipe-projection-a64/report.json"
      ],
      "argv": [
        "{python}",
        "scripts/evaluate_hipe_projection_a64.py"
      ],
      "timeout_seconds": 180
    },
    {
      "id": "a65_prepare",
      "kind": "external",
      "resource": "orchestrator",
      "deps": [
        "a64_score"
      ],
      "inputs": [
        "experiments/loop/hipe-projection-a64/report.json",
        "experiments/loop/next-a64/RESULTS.md"
      ],
      "outputs": [
        "experiments/loop/next-a65/PROTOCOL.md"
      ],
      "instructions": "Inspect the current Claude branch before choosing a new hypothesis. Treat A64 as a consumed metric projection only. Advance the distinct predicted-geometry/OLR track with a frozen diverse ground-truth protocol, or a genuinely independent OCR validation if reliable GT is found. Read and separately summarize every new primary source or arXiv paper. Do not retune 0455, do not rewrite reference XML, and do not infer unobserved VLM outputs. Add executable queue jobs, run useful ready work immediately, commit/push and checkpoint after the completed experiment."
    }
  ]
}
