{
  "schema": "bbvlm.queue/1",
  "resources": {
    "cpu": 1,
    "io": 2,
    "vlm": 1,
    "orchestrator": 1
  },
  "jobs": [
    {
      "id": "a62_dispatch_tests",
      "kind": "command",
      "resource": "cpu",
      "deps": [],
      "inputs": [
        "scripts/experiment_queue.py",
        "tests/test_experiment_queue.py"
      ],
      "outputs": [
        "experiments/loop/queue-a62/dispatched-tests.json"
      ],
      "argv": [
        "{python}",
        "tests/test_experiment_queue.py",
        "--report",
        "experiments/loop/queue-a62/dispatched-tests.json"
      ],
      "timeout_seconds": 30
    },
    {
      "id": "a62_visual_input_fixity",
      "kind": "command",
      "resource": "io",
      "deps": [],
      "inputs": [
        "scripts/audit_queue_inputs_a62.py",
        "experiments/loop/bnl-bands-a60/blind/request.json",
        "experiments/loop/bnl-guard-a61/blind/V1.png",
